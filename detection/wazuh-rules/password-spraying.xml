<!--
  Scénario 1 : password spraying (MITRE T1110.003)
  A déployer dans /var/ossec/etc/rules/local_rules.xml du manager Wazuh.
  Seuils calibrés pour un lab de 5 comptes : à relever en production.
-->
<group name="purplelab,password_spraying,">

  <!-- NTLM : 3 x 4625 depuis une même IP sur 3 comptes différents en 5 min -->
  <rule id="100110" level="12" frequency="3" timeframe="300">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <not_same_field>win.eventdata.targetUserName</not_same_field>
    <description>Password spraying (NTLM) depuis $(win.eventdata.ipAddress) - plusieurs comptes en echec</description>
    <mitre><id>T1110.003</id></mitre>
  </rule>

  <!-- Kerberos : 4771 pre-auth echouee (0x18 mauvais mdp, 0x12 compte verrouille) -->
  <rule id="100101" level="5">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID" type="pcre2">^4771$</field>
    <field name="win.eventdata.status" type="pcre2">(?i)^0x(18|12)$</field>
    <description>Kerberos : pre-auth echouee pour $(win.eventdata.targetUserName) depuis $(win.eventdata.ipAddress)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- Kerberos : 2 x 4771 depuis une même IP sur 2 comptes différents en 5 min -->
  <rule id="100111" level="12" frequency="2" timeframe="300">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <not_same_field>win.eventdata.targetUserName</not_same_field>
    <description>Password spraying (Kerberos) depuis $(win.eventdata.ipAddress) - plusieurs comptes en echec</description>
    <mitre><id>T1110.003</id></mitre>
  </rule>

</group>
